# Copy to .env (or .env.local) only if you need to change a default.

# Where the Vite dev server forwards /api/* calls (your Spring Cloud Gateway).
VITE_DEV_PROXY_TARGET=http://localhost:8090

# Leave empty in dev (requests go through the proxy). For a production build
# served from another origin, set the gateway URL and enable CORS on it.
VITE_API_BASE_URL=

# Keycloak (public PKCE client)
VITE_KEYCLOAK_URL=http://localhost:8443
VITE_KEYCLOAK_REALM=ecom-app
VITE_KEYCLOAK_CLIENT_ID=oauth2-pkce

# Display
VITE_STORE_NAME=ecom
VITE_CURRENCY=USD
# VITE_LOCALE=en-US

# Stripe (Optional publishable key for client-side integration)
VITE_STRIPE_PUBLIC_KEY=pk_test_placeholder
